# Hermes skill runtime state (usage tracking)
agents/research/skills/.usage.json
agents/research/skills/.usage.json.lock
agents/research/skills/.curator_ledger.jsonl
agents/video/skills/.usage.json
agents/video/skills/.usage.json.lock
agents/video/skills/.hub/
agents/video/skills/.curator_ledger.jsonl

# Hermes memory runtime locks (lock files, not the record; MEMORY.md itself is committed)
agents/*/memories/*.lock

# Vendored Hermes bundled skills — version-pinned by .bundled_manifest,
# re-syncable from the Hermes install
agents/research/skills/autonomous-ai-agents/
agents/video/skills/autonomous-ai-agents/

# Machine-local agent runtime config (localhost provider endpoint, display)
agents/research/config.yaml
agents/video/config.yaml

# Render outputs and QA artifacts are reproducible from the committed video dir;
# they are not part of the record (regenerable = not committed).
videos/*/renders/
videos/*/snapshots/

# Raw data snapshots — live on disk in data/ for viewing, never in git.
# The contract is research/data/: manifests, checksums.txt, verify.py.
data/*
!data/README.md

# Python bytecode from pipeline tool runs
__pycache__/

# ElevenLabs SDK venv (rebuild: uv venv + uv pip install -r requirements.lock.txt)
videos/pipeline/tts/.venv/

# Voice audition samples — owner review only; the pin + first real voiceover
# are the record (regenerable artifacts, not committed)
videos/*/audio/auditions/
